{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "LogFile": {
    "Enabled": true,
    "Path": "logs/products-.json"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=products.db"
  },
  "AllowedHosts": "*",
  "ErrorHandling": {
    "IncludeExceptionDetails": false
  },
  "Services": {
    "OrdersApi": {
      "BaseUrl": "http://localhost:5003/"
    }
  }
}
