{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "LogFile": {
    "Enabled": true,
    "Path": "logs/notifications-.json"
  },
  "AllowedHosts": "*",
  "ErrorHandling": {
    "IncludeExceptionDetails": false
  },
  "Services": {
    "UsersApi": {
      "BaseUrl": "http://localhost:5002/"
    }
  }
}
